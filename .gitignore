# --- the published site ----------------------------------------------------
# GitHub Pages serves docs/: the pages, docs/assets/, and the bundles under
# docs/corpus/ and docs/data/. Those are the built artifact and are tracked.
#
# The rules below describe the *source* tree — a developer running the
# tools in this repository should not be able to commit gigabytes by
# accident — so they name the source directories exactly, and never
# docs/.
corpus/
sources/
build/
voices/

# --- generated -------------------------------------------------------------
__pycache__/
*.pyc
*.tmp

# --- local -----------------------------------------------------------------
.venv/
.trash/
