# --- the published site ----------------------------------------------------
# GitHub Pages serves docs/: the pages, assets/, and the bundles under
# docs/corpus/ and docs/data/. Those are the built artifact and are tracked.
# The *source* corpus, the downloaded scans and the derived data that the
# build tools can regenerate are not, so a developer running the tools in
# this repository cannot commit gigabytes by accident.
corpus/
sources/
build/
docs/corpus/*.bin
!docs/corpus/*.bin

# --- generated -------------------------------------------------------------
__pycache__/
*.pyc
*.tmp

# --- local -----------------------------------------------------------------
.venv/
.trash/

# --- the voice ------------------------------------------------------------
voices/
